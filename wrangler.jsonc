{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kochbuch",
  "compatibility_date": "2026-09-01",
  // Jekyll baut nach _site, Cloudflare liefert es aus. Nur /api/* läuft durch den Worker
  // (Anmeldung per Passkey, Sync, Rezept-Upload); siehe worker/index.js.
  "main": "worker/index.js",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Ohne "id" legt Wrangler den KV-Speicher beim ersten Deploy automatisch an.
  "kv_namespaces": [
    { "binding": "KV" }
  ],
  // Timer-Mitteilungen (worker/index.js, TimerAlarms): ein Durable Object pro Profil mit Alarm.
  "durable_objects": {
    "bindings": [{ "name": "TIMERS", "class_name": "TimerAlarms" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TimerAlarms"] }
  ],
  "vars": {
    "GITHUB_REPO": "tbsxxl/Kochen",
    "GITHUB_BRANCH": "main"
  },
  "observability": { "enabled": true }
}
